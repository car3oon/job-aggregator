{
  "name": "job-aggregator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "test:auth": "node --test --test-reporter=spec \"tests/auth/**/*.test.ts\"",
    "test:scraper": "node --test --test-reporter=spec \"tests/scraper/**/*.test.ts\"",
    "test:polling": "node --test --test-reporter=spec \"tests/polling/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.1",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "playwright": "^1.64.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "unrs-resolver"
    ],
    "overrides": {
      "@modelcontextprotocol/sdk": ">=1.32.0",
      "mysql2": ">=3.23.1",
      "source-map-js": ">=1.2.2",
      "lodash": ">=4.17.24",
      "deepmerge-ts": ">=8.0.0",
      "undici": ">=7.30.1",
      "body-parser": ">=2.4.0",
      "zod": ">=4.6.6"
    }
  }
}
