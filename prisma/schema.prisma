generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  url         String   @unique
  source      String
  workMode    String
  location    String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id   String  @id @default(uuid())
  name String  @unique
  slug String  @unique
  icon String?
}

model ScraperUrl {
  id        String   @id @default(uuid())
  url       String   @unique
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
