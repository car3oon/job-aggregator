generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id              String           @id @default(uuid())
  title           String
  url             String           @unique
  source          String           // e.g., "JustJoinIT"
  categories      Category[]       // Many-to-many relation
  workPreferences WorkPreference[] // Many-to-many relation
  description     String?          @db.Text // Optional full description/content
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  scraperUrlId    String?
  scraperUrl      ScraperUrl?      @relation(fields: [scraperUrlId], references: [id], onDelete: SetNull)
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  keywords  String[] // Words required for a match
  excluded  String[] // Words that exclude an offer from this category
  icon      String?
  jobs      Job[]    // Many-to-many relation
}

model WorkPreference {
  id        String   @id @default(uuid())
  name      String   @unique
  keywords  String[] // Keywords (e.g., ["remote", "hybrid", "home office"])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  jobs      Job[]    // Many-to-many relation
}

model ScraperUrl {
  id        String   @id @default(uuid())
  url       String   @unique
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  jobs      Job[]    // One-to-many relation
}
